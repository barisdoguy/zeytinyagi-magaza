# ── Genel ────────────────────────────────────────────────────────────────
# Sitenin herkese açık adresi (sonunda / olmadan). Canonical, sitemap ve
# ödeme geri dönüş adresleri bundan üretilir.
SITE_URL=http://localhost:3000

# Veritabanı ve yüklenen görsellerin tutulduğu klasör. Canlıda kalıcı bir
# disk yolu olmalı ve düzenli yedeklenmeli.
DATA_DIR=./data

# İmzalama için gizli anahtar. Canlıda zorunlu, en az 32 karakter.
# Üretmek için:  openssl rand -base64 48
APP_SECRET=

# Arama motorlarına açılma. Site yayına hazır olana dek "false" kalsın;
# "false" iken robots.txt tüm siteyi kapatır.
SITE_INDEXABLE=false

# ── Ödeme ────────────────────────────────────────────────────────────────
# none   : çevrimiçi ödeme kapalı (sipariş oluşturulamaz)
# test   : gerçek tahsilat yapmayan deneme sağlayıcısı (yalnızca PAYMENTS_MODE=test iken)
# paytr  : PayTR iFrame API
# iyzico : iyzico Checkout Form (adaptör iskelet hâlinde, README'ye bakın)
PAYMENTS_PROVIDER=test

# test : geliştirme / deneme ortamı.  live : gerçek tahsilat.
# "live" iken deneme sağlayıcısı kendiliğinden devre dışı kalır.
PAYMENTS_MODE=test

# PayTR (Mağaza Paneli → Destek & Kurulum → Entegrasyon Bilgileri)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# iyzico (Kontrol Paneli → Ayarlar → Firma Ayarları → API Anahtarları)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Deneme: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=

# ── Reklam ölçümleme (isteğe bağlı) ─────────────────────────────────────
# Boş bırakılırsa ilgili etiket hiç yüklenmez. Dolu olsa bile ziyaretçi
# çerez tercihlerinde izin vermeden çalışmaz.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
